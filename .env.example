# NSE Alpha Quant - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=production
DEBUG=false
APP_NAME=NSE Alpha Quant
APP_VERSION=2.0.0

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=sqlite:///nse_alpha_quant.db
# For PostgreSQL: postgresql://user:password@localhost:5432/nse_alpha_quant
# For MySQL: mysql://user:password@localhost:3306/nse_alpha_quant

# =============================================================================
# Upstox API Configuration
# =============================================================================
# Get your API credentials from: https://upstox.com/developer/
UPSTOX_API_KEY=your_api_key_here
UPSTOX_ACCESS_TOKEN=your_access_token_here
USE_SANDBOX_FALLBACK=true

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://127.0.0.1:3000"]

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=app.log

# =============================================================================
# Security Configuration
# =============================================================================
# Rate limiting (requests per minute)
API_RATE_LIMIT_PER_MINUTE=60

# Circuit breaker settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# =============================================================================
# Performance Configuration
# =============================================================================
# Maximum concurrent API requests
MAX_CONCURRENT_REQUESTS=10

# Database connection pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# Backtest Configuration
# =============================================================================
BACKTEST_LOOKBACK_DAYS=252
BACKTEST_MIN_WIN_RATE=55.0
BACKTEST_MAX_DRAWDOWN=15.0

# =============================================================================
# Technical Analysis Configuration
# =============================================================================
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL_PERIOD=9
EMA_SHORT=50
EMA_LONG=200
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3.0

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000
